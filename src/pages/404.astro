---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden | wunschausbau.de" description="Die angeforderte Seite existiert nicht." noindex>
  <section class="section status-page">
    <div class="wrap status-page__inner">
      <p class="eyebrow">Fehler 404</p>
      <h1>Diese Seite gibt es nicht.</h1>
      <p class="lead">Die Adresse ist veraltet oder wurde falsch eingegeben.</p>
      <a class="btn" href="/">Zur Startseite</a>
    </div>
  </section>
</Base>

<style>
  .eyebrow { justify-content: center; }
</style>
