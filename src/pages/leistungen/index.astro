---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { withBase } from '../../lib/paths';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---
<Base
  title="Leistungen | wunschausbau.de – Innenausbau in Wittlich, Trier & Mosel"
  description="Unsere Leistungen im Überblick: Böden, Innentüren, Fenster & Außentüren, Sonnenschutz, Trockenbau, Holzterrassen und komplette Renovierungen."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Leistungen</p>
      <h1>Alles aus einer Hand.</h1>
      <p class="lead">Sieben Gewerke, ein Anspruch: saubere, präzise Arbeit – von der Beratung bis zur Übergabe.</p>

      <div class="list">
        {leistungen.map((leistung, index) => (
          <a class="row reveal" href={withBase(`/leistungen/${leistung.id}/`)} style={`--reveal-delay: ${(index % 3) * 45}ms`}>
            <span class="idx" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="row-text">
              <h2>{leistung.data.title}</h2>
              <p>{leistung.data.kurztext}</p>
              <span class="row-link">Leistung ansehen <span aria-hidden="true">→</span></span>
            </div>
            <div class="row-media">
              <Image src={leistung.data.bild} alt={leistung.data.bildAlt} widths={[320, 640]} sizes="(max-width: 56rem) 100vw, 260px" quality={72} format="webp" loading="lazy" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .list { margin-top: var(--space-6); border-top: 1px solid var(--line); }
  .row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(13rem, 16rem);
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .idx {
    color: var(--brass);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
  }
  .row h2 { font-size: clamp(1.45rem, 2.5vw, 1.9rem); transition: color var(--dur) var(--ease); }
  .row-text p { margin-top: .35rem; color: var(--ink-soft); font-size: var(--text-sm); }
  .row-link {
    display: inline-flex;
    gap: .4rem;
    margin-top: .6rem;
    color: var(--brass-deep);
    font-size: var(--text-sm);
    font-weight: 650;
  }
  .row-media { overflow: hidden; border-radius: var(--radius); }
  .row :global(img) {
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    transition: transform 280ms var(--ease-move);
  }

  @media (hover: hover) and (pointer: fine) {
    .row:hover { color: var(--ink); background: var(--sand); }
    .row:hover h2 { color: var(--brass-deep); }
    .row:hover :global(img) { transform: scale(1.025); }
  }

  @media (max-width: 56rem) {
    .row { grid-template-columns: minmax(9rem, 38%) minmax(0, 1fr); gap: var(--space-3); }
    .idx { display: none; }
    .row-media { grid-column: 1; grid-row: 1; }
    .row-text { grid-column: 2; }
  }

  @media (max-width: 36rem) {
    .row { grid-template-columns: 1fr; padding-block: var(--space-3); }
    .row-media, .row-text { grid-column: 1; }
    .row-media { grid-row: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .row, .row h2, .row :global(img) { transition: none; }
  }
</style>
