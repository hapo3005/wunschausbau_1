---
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import logoUrl from '../assets/logo.svg?url';

const nav = [
  { href: withBase('/leistungen/'), label: 'Leistungen' },
  { href: withBase('/referenzen/'), label: 'Referenzen' },
  { href: withBase('/ueber-uns/'), label: 'Über uns' },
  { href: withBase('/kontakt/'), label: 'Kontakt' }
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${settings.marke} – Startseite`}>
      <img class="brand-mark" src={logoUrl} width="449" height="452" alt="" />
      <span class="brand-copy">
        <span class="brand-name">{settings.marke}</span>
        <span class="brand-claim">{settings.claim}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation" id="site-nav">
      {nav.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="nav-phone" href={`tel:${settings.telefonLink}`} aria-label={`Anrufen: ${settings.telefon}`}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M7.1 2.8 10 7.9 7.7 10a15.1 15.1 0 0 0 6.3 6.3l2.1-2.3 5.1 2.9-.7 3.3c-.2.8-.9 1.4-1.8 1.4A16.4 16.4 0 0 1 2.4 5.3c0-.9.6-1.6 1.4-1.8l3.3-.7Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/>
        </svg>
        <span>{settings.telefon}</span>
      </a>
      <a class="btn nav-cta" href={withBase('/kontakt/')}>Projekt anfragen</a>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
  </div>
  <button class="nav-backdrop" type="button" tabindex="-1" aria-hidden="true" aria-label="Menü schließen"></button>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: var(--header-height);
    background: rgba(255, 255, 255, .9);
    border-bottom: 1px solid rgba(227, 221, 210, .88);
    backdrop-filter: blur(14px) saturate(130%);
  }

  .header-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .72rem;
    flex: 0 0 auto;
    color: var(--ink);
    line-height: 1.15;
    text-decoration: none;
  }

  .brand-mark {
    width: 3.15rem;
    height: 3.15rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .brand-copy {
    display: grid;
    min-width: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: -.02em;
  }

  .brand-claim {
    margin-top: .1rem;
    color: var(--brass-deep);
    font-size: .7rem;
    font-weight: 650;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-left: auto;
  }

  .site-nav > a:not(.btn) {
    position: relative;
    padding: .6rem 0;
    color: var(--ink);
    font-size: .94rem;
    font-weight: 550;
    text-decoration: none;
  }

  .site-nav > a:not(.btn)::after {
    position: absolute;
    right: 0;
    bottom: .35rem;
    left: 0;
    height: 1px;
    background: var(--brass);
    content: "";
    opacity: 0;
    transform: scaleX(.35);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease-move);
  }

  .site-nav > a[aria-current="page"]::after { opacity: 1; transform: scaleX(1); }

  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    color: var(--ink-soft) !important;
    font-variant-numeric: tabular-nums;
  }

  .nav-phone svg { width: 1.05rem; height: 1.05rem; }
  .nav-cta { min-height: 2.8rem; padding-inline: 1.1rem; font-size: .94rem; }
  .menu-btn, .nav-backdrop { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover { color: var(--ink); }
    .site-nav > a:not(.btn):hover::after { opacity: 1; transform: scaleX(1); }
  }

  @media (max-width: 64rem) {
    .site-nav { gap: 1rem; }
    .nav-phone span { display: none; }
    .nav-phone svg { width: 1.2rem; height: 1.2rem; }
  }

  @media (max-width: 56rem) {
    .brand { gap: .62rem; }
    .brand-mark { width: 2.85rem; height: 2.85rem; }

    .site-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: calc(100svh - var(--header-height));
      margin: 0;
      padding: .5rem var(--pad-inline) 1.25rem;
      overflow-y: auto;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-float);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-.6rem);
      transition:
        opacity var(--dur) var(--ease),
        transform var(--dur) var(--ease-move),
        visibility 0s linear var(--dur);
    }

    .site-nav.open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .site-nav > a:not(.btn) {
      display: flex;
      align-items: center;
      min-height: 3.25rem;
      padding: .75rem 0;
      border-bottom: 1px solid var(--line);
      font-size: 1rem;
    }

    .site-nav > a:not(.btn)::after { display: none; }
    .nav-phone span { display: inline; }
    .nav-cta { min-height: 3.25rem; margin-top: var(--space-2); }

    .menu-btn {
      display: grid;
      width: 3rem;
      height: 3rem;
      margin-left: auto;
      padding: 0;
      place-content: center;
      gap: 5px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: var(--ink);
      background: transparent;
      cursor: pointer;
      transition: transform var(--dur-fast) var(--ease), border-color var(--dur) var(--ease);
      -webkit-tap-highlight-color: transparent;
    }

    .menu-btn:active { transform: scale(.96); }
    .menu-btn span {
      width: 1.25rem;
      height: 2px;
      background: currentColor;
      transform-origin: center;
      transition: transform var(--dur) var(--ease-move), opacity var(--dur-fast) var(--ease);
    }
    .menu-btn[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .menu-btn[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .nav-backdrop {
      position: fixed;
      inset: var(--header-height) 0 0;
      z-index: 1;
      display: block;
      width: 100%;
      border: 0;
      background: rgba(23, 24, 27, .28);
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--dur) var(--ease), visibility 0s linear var(--dur);
    }
    .site-header.menu-open .nav-backdrop {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
  }

  @media (max-width: 26rem) {
    .brand-name { font-size: 1.08rem; }
    .brand-claim { font-size: .6rem; letter-spacing: .11em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav, .site-nav > a:not(.btn)::after, .menu-btn, .menu-btn span, .nav-backdrop { transition: none; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const button = header?.querySelector('.menu-btn');
  const navigation = header?.querySelector('#site-nav');
  const backdrop = header?.querySelector('.nav-backdrop');
  const mobile = window.matchMedia('(max-width: 56rem)');

  const setMenu = (open) => {
    navigation?.classList.toggle('open', open);
    header?.classList.toggle('menu-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    document.body.classList.toggle('nav-open', open && mobile.matches);
  };

  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  backdrop?.addEventListener('click', () => setMenu(false));
  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      button.focus();
    }
  });
  mobile.addEventListener('change', (event) => {
    if (!event.matches) setMenu(false);
  });
</script>

<style is:global>
  @media (max-width: 56rem) {
    body.nav-open { overflow: hidden; }
  }
</style>
